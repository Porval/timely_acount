HOST=127.0.0.1
PORT=3100
NODE_ENV=development
DATABASE_FILE=data/accounts.sqlite
# 旧 JSON 文件首次启动时自动迁移，原文件保留
# DATA_FILE=data/accounts.json
# 开发模式仅允许本机，页面和终端显示验证码，不发送短信
SMS_MODE=console
# 配置真实短信接口后改为 remote
# SMS_MODE=remote
# 对应 warehouse_account 的 DEBUG_SMS_HOST，保留已有基础路径
# DEBUG_SMS_HOST=https://your-sms-service.example
# 上游验证手机号字段默认为 phone；当前真实短信服务要求 number
# SMS_VERIFY_PHONE_FIELD=number
# 验证请求的验证码字段，暂定 code；若接口要求 verifyCode 则修改此项
# SMS_VERIFY_CODE_FIELD=code
# 可选：需要 Bearer 鉴权时配置，否则不发送 Authorization
# SMS_API_TOKEN=
# 可选：覆盖服务端短信模板，不允许前端传模板
# DEBUG_SMS_TEM=【上海蜜田科技】注册绑定手机号验证码是${code}
# 生产环境必须设置 HTTPS 后台域名
# APP_ORIGIN=https://your-accounts.example

# 订单管理端专用密钥（32 位以上字母数字），仅后端持有
# ORDER_MANAGEMENT_TOKEN=
# 履约系统，参考原 timelyClient 的 POST /admin/timelyOrders/ 和 SHA256 签名
# TIMELY_ORDER_HOST=https://your-timely-service.example/
# TIMELY_ORDER_KEY=
# TIMELY_ORDER_SECRET=
# TIMELY_ORDER_SERVICE=
# TIMELY_CREATOR_ID=

# 仅确认履约系统支持 Idempotency-Key 后开启自动重试
# TIMELY_IDEMPOTENCY_SUPPORTED=false

# 平台服务商所属平台 ID；配置后限制目录及履约建单的平台
# TIMELY_PLATFORM_ID=

# 标准商品库，仅由后台持有鉴权参数
# STANDARD_ITEM_HOST=
# STANDARD_ITEM_KEY=
# STANDARD_ITEM_SECRET=
